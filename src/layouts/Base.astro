---
import "@/styles/global.css";
import T from "@/components/T.astro";
import { profile, type L } from "@/data/site";

interface Props {
  title?: L;
  description?: L;
}

const base: L = { en: `${profile.name} · ${profile.role.en}`, es: `${profile.name} · ${profile.role.es}` };
const title: L = Astro.props.title
  ? { en: `${Astro.props.title.en} · ${profile.name}`, es: `${Astro.props.title.es} · ${profile.name}` }
  : base;
const description = Astro.props.description ?? profile.description;
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en" data-lang="en" data-theme="dark" data-title-en={title.en} data-title-es={title.es}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title.en}</title>
    <meta name="description" content={description.en} />
    <meta name="author" content={profile.fullName} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title.en} />
    <meta property="og:description" content={description.en} />
    <meta property="og:image" content="/avatar.png" />
    <meta name="twitter:card" content="summary" />
    <meta name="theme-color" content="#060609" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#eeeef4" media="(prefers-color-scheme: light)" />

    <!-- Idioma y tema antes del primer pintado: evita el parpadeo al cargar -->
    <script is:inline>
      (function () {
        var d = document.documentElement, l, t;
        try { l = localStorage.getItem("lang"); t = localStorage.getItem("theme"); } catch (e) {}
        d.dataset.lang = l === "es" ? "es" : "en";
        d.lang = d.dataset.lang;
        d.dataset.theme = t === "light" || t === "dark" ? t : matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark";
        if (d.dataset.lang === "es" && d.dataset.titleEs) document.title = d.dataset.titleEs;
      })();
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500&family=Geist+Mono:wght@400&display=swap"
    />

    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Person",
        name: profile.fullName,
        jobTitle: profile.role.en,
        email: profile.email,
        address: { "@type": "PostalAddress", addressLocality: "Los Ángeles", addressCountry: "CL" },
        sameAs: ["https://github.com/MoisesFigueroaV", "https://www.linkedin.com/in/moisesfigueroavalen", "https://x.com/Moises_Figue26"],
      })}
    />
  </head>
  <body>
    <canvas id="bg" aria-hidden="true"></canvas>
    <div class="veil" aria-hidden="true"></div>
    <div class="lid top" aria-hidden="true"></div>
    <div class="lid bot" aria-hidden="true"></div>

    <div class="prefs" role="group" aria-label="Language and theme">
      <button type="button" data-set-lang="en" aria-pressed="true">EN</button>
      <i aria-hidden="true">•</i>
      <button type="button" data-set-lang="es" aria-pressed="false">ES</button>
      <button type="button" class="theme" data-toggle-theme aria-label="Switch theme">
        <svg class="sun" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true">
          <circle cx="8" cy="8" r="3"></circle>
          <path d="M8 1v2M8 13v2M1 8h2M13 8h2M3 3l1.4 1.4M11.6 11.6 13 13M3 13l1.4-1.4M11.6 4.4 13 3"></path>
        </svg>
        <svg class="moon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true">
          <path d="M13.5 9.5A5.5 5.5 0 0 1 6.5 2.5a5.5 5.5 0 1 0 7 7z"></path>
        </svg>
      </button>
    </div>

    <main>
      <slot />
    </main>

    <footer class="site">
      <nav aria-label="Site">
        <a href="/"><T t={{ en: "Home", es: "Inicio" }} /></a>
        <a href="/writing"><T t={{ en: "Writing", es: "Escritos" }} /></a>
        <a href="/gallery"><T t={{ en: "Gallery", es: "Galería" }} /></a>
        <a href={profile.cv} target="_blank" rel="noopener">CV</a>
      </nav>
      <span>© {year} · {profile.location}</span>
    </footer>

    <script>
      import { startBackground } from "@/scripts/background";
      import "@/scripts/prefs";
      const canvas = document.getElementById("bg");
      if (canvas instanceof HTMLCanvasElement) startBackground(canvas);
    </script>
  </body>
</html>
