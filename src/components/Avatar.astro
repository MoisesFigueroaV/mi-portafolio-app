---
/** Avatar 16-bit (public/avatar.png, 32×32) con la gatita. Sus ojos los cierra src/scripts/prefs.ts. */
interface Props {
  size?: number;
}
const { size = 72 } = Astro.props;
---

<span class="avatar" style={`--s:${size}px`} role="img" aria-label="Pixel-art portrait of Moisés with a black cat on his head">
  <svg viewBox="0 0 32 32" aria-hidden="true">
    <rect width="32" height="32" fill="var(--avatar-bg)"></rect>
    <image href="/avatar.png" width="32" height="32"></image>
    <g class="cat-lids" opacity="0">
      <rect x="12" y="6" width="2" height="2" fill="#0f0d12"></rect>
      <rect x="18" y="6" width="2" height="2" fill="#0f0d12"></rect>
    </g>
  </svg>
</span>

<style>
  .avatar {
    flex: none;
    width: var(--s);
    height: var(--s);
    border-radius: 50%;
    overflow: hidden;
    display: block;
  }
  svg {
    width: 100%;
    height: 100%;
    display: block;
    image-rendering: pixelated;
  }
</style>
